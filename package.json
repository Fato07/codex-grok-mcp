{
  "name": "codex-grok-mcp",
  "version": "0.2.0-beta.5",
  "description": "Unofficial local MCP bridge from Codex to isolated Grok calls and experimental persistent Grok Bots.",
  "author": "Fato07",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fato07/codex-grok-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Fato07/codex-grok-mcp/issues"
  },
  "homepage": "https://fato07.github.io/codex-grok-mcp/",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codex-grok-mcp": "dist/index.js",
    "codex-grok-bridge": "dist/bridge-companion.js"
  },
  "files": [
    "dist",
    "relay/.dev.vars.example",
    "relay/README.md",
    "relay/package-lock.json",
    "relay/package.json",
    "relay/src",
    "relay/test",
    "relay/tsconfig.json",
    "relay/vitest.config.ts",
    "relay/worker-configuration.d.ts",
    "relay/wrangler.jsonc",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "RELEASING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.19.2"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "bridge:probe": "node dist/bridge-companion.js probe",
    "doctor": "node dist/index.js --doctor",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:relay": "npm --prefix relay run check && npm --prefix relay test",
    "test:all": "npm test && npm run test:relay",
    "prepublishOnly": "npm --prefix relay ci && npm run test:all",
    "prepare": "npm run build"
  },
  "keywords": [
    "codex",
    "grok",
    "xai",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
