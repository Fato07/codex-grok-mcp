{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-grok-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Required secret: set with `npx wrangler secret put RELAY_ACCESS_TOKEN`.
  // Never add its value to `vars` or source control.
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "Relay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Relay"]
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
